{
  "id": "crm-google-sheet",
  "display_name": "CRM Google Sheet",
  "description": "Generate a Google-Sheets-compatible CRM workbook and mail-driven update proposals; live sheet writes are gated.",
  "required_connectors": [],
  "read_sources": [
    {
      "type": "mail_provider_adapter",
      "mode": "read-only"
    },
    {
      "type": "xlsx_or_csv",
      "path_config_key": "modules.crm-google-sheet.workbook_path",
      "mode": "read-only unless approved"
    }
  ],
  "write_targets": [
    {
      "type": "local_xlsx_or_csv",
      "path_config_key": "modules.crm-google-sheet.workbook_path",
      "requires_approval": true
    },
    {
      "type": "google_sheet",
      "requires_approval": true,
      "requires_connector": "google-drive-or-sheets"
    }
  ],
  "config_schema": {
    "type": "object",
    "required": [
      "enabled",
      "workbook_path",
      "proposal_output_dir"
    ],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "workbook_path": {
        "type": "string"
      },
      "proposal_output_dir": {
        "type": "string"
      },
      "csv_seed_dir": {
        "type": "string"
      },
      "seed_queries": {
        "type": "array"
      },
      "allow_live_sheet_writes": {
        "type": "boolean"
      }
    }
  },
  "onboarding": {
    "question": "Should close-day create or connect a CRM for account/contact/follow-up proposals?",
    "default_for_profiles": [
      "solo_operator"
    ],
    "setup_questions": [
      "Do you already have a CRM workbook or Google Sheet?",
      "If not, should setup create the close-day CRM workbook template?",
      "Which customer, prospect, partner, and program keywords should seed mail searches?",
      "Should CRM updates stay proposal-only or allow sheet updates after approval?"
    ],
    "connector_probes": [
      "Check the configured Gmail or Outlook adapter when mail seeding is enabled.",
      "Check workbook path exists when an existing CRM is selected."
    ],
    "required_artifacts": [
      "CRM workbook or Google Sheet with Accounts, Contacts, Interactions, FollowUps, and Lists."
    ],
    "optional_artifacts": [
      "Provider-neutral mail seed queries.",
      "Dry-run CRM proposal output folder."
    ],
    "config_keys": [
      "modules.crm-google-sheet.workbook_path",
      "modules.crm-google-sheet.csv_seed_dir",
      "modules.crm-google-sheet.proposal_output_dir",
      "modules.crm-google-sheet.seed_queries",
      "modules.crm-google-sheet.enabled",
      "modules.crm-google-sheet.allow_live_sheet_writes"
    ]
  },
  "enabled_by_default": true,
  "proposal_output_type": "crm_update_proposal"
}
