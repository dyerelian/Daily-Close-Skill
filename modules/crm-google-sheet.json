{
  "id": "crm-google-sheet",
  "display_name": "CRM Google Sheet",
  "description": "Create a portable CRM workbook or delegate incremental, scope-bound CRM reconciliation to a configured handler skill; all live writes are proposal-gated.",
  "required_connectors": [],
  "read_sources": [
    {
      "type": "mail_provider_adapter",
      "mode": "read-only"
    },
    {
      "type": "calendar_provider_adapter",
      "mode": "read-only"
    },
    {
      "type": "delegated_skill",
      "skill_config_key": "modules.crm-google-sheet.handler_skill",
      "mode": "read-only until the consolidated proposal is approved"
    },
    {
      "type": "xlsx_or_csv",
      "path_config_key": "modules.crm-google-sheet.workbook_path",
      "mode": "read-only unless approved"
    }
  ],
  "write_targets": [
    {
      "type": "local_xlsx_or_csv",
      "path_config_key": "modules.crm-google-sheet.workbook_path",
      "requires_approval": true
    },
    {
      "type": "google_sheet",
      "requires_approval": true,
      "requires_connector": "google-drive-or-sheets"
    }
  ],
  "config_schema": {
    "type": "object",
    "required": [
      "enabled"
    ],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "mode": {
        "type": "string"
      },
      "workbook_path": {
        "type": "string"
      },
      "proposal_output_dir": {
        "type": "string"
      },
      "csv_seed_dir": {
        "type": "string"
      },
      "seed_queries": {
        "type": "array"
      },
      "allow_live_sheet_writes": {
        "type": "boolean"
      },
      "scope_ids": {
        "type": "array"
      },
      "handler_skill": {
        "type": "string"
      },
      "handler_path": {
        "type": "string"
      },
      "review_mode": {
        "type": "string"
      },
      "first_run_lookback_days": {
        "type": "integer"
      },
      "overlap_hours": {
        "type": "integer"
      },
      "allow_new_rows": {
        "type": "boolean"
      },
      "minimum_confidence": {
        "type": "string"
      },
      "roll_weekly_jira": {
        "type": "boolean"
      }
    }
  },
  "onboarding": {
    "question": "Should close-day create or connect a CRM for account/contact/follow-up proposals?",
    "default_for_profiles": [
      "solo_operator"
    ],
    "setup_questions": [
      "Do you need a portable workbook or an existing-CRM handler skill?",
      "If not, should setup create the close-day CRM workbook template?",
      "Which configured scopes may send evidence to the CRM handler?",
      "Should each close run an incremental review, and how far back should its first run look?",
      "May completed meetings support labeled inferences, and what minimum confidence may be proposed?",
      "May clearly identified contacts be proposed as new rows?",
      "Which customer, prospect, partner, and program keywords should seed mail searches?",
      "Should CRM updates stay proposal-only or allow sheet updates after approval?"
    ],
    "connector_probes": [
      "Check the configured Gmail or Outlook adapter when mail seeding is enabled.",
      "Check workbook path exists for portable_workbook mode.",
      "Check the configured handler skill and its declared CRM access route for delegated_handler mode."
    ],
    "required_artifacts": [
      "Portable CRM workbook, or a configured handler skill that owns an existing CRM schema and access route."
    ],
    "optional_artifacts": [
      "Provider-neutral mail seed queries.",
      "Dry-run CRM proposal output folder."
    ],
    "config_keys": [
      "modules.crm-google-sheet.workbook_path",
      "modules.crm-google-sheet.csv_seed_dir",
      "modules.crm-google-sheet.proposal_output_dir",
      "modules.crm-google-sheet.seed_queries",
      "modules.crm-google-sheet.enabled",
      "modules.crm-google-sheet.mode",
      "modules.crm-google-sheet.allow_live_sheet_writes",
      "modules.crm-google-sheet.scope_ids",
      "modules.crm-google-sheet.handler_skill",
      "modules.crm-google-sheet.handler_path",
      "modules.crm-google-sheet.review_mode",
      "modules.crm-google-sheet.first_run_lookback_days",
      "modules.crm-google-sheet.overlap_hours",
      "modules.crm-google-sheet.allow_new_rows",
      "modules.crm-google-sheet.minimum_confidence",
      "modules.crm-google-sheet.roll_weekly_jira"
    ]
  },
  "enabled_by_default": true,
  "proposal_output_type": "crm_update_proposal"
}
