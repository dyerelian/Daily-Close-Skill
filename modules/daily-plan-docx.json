{
  "id": "daily-plan-docx",
  "display_name": "Daily Plan DOCX",
  "description": "Generate the next working day's Daily Plan Word document after the consolidated proposal is approved.",
  "required_connectors": [
    "local:file-system"
  ],
  "read_sources": [
    {
      "type": "json_payload",
      "mode": "generated from approved proposal"
    }
  ],
  "write_targets": [
    {
      "type": "docx",
      "path_config_key": "artifacts.workspace_root",
      "requires_approval": true
    }
  ],
  "config_schema": {
    "type": "object",
    "required": [
      "enabled"
    ],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "output_dir": {
        "type": [
          "string",
          "null"
        ]
      },
      "allow_generation": {
        "type": "boolean"
      }
    }
  },
  "onboarding": {
    "question": "Should close-day generate a next-day Daily Plan document?",
    "default_for_profiles": [
      "solo_operator"
    ],
    "setup_questions": [
      "Should the Daily Plan be exported as DOCX independently of agenda DOCX exports?",
      "Which workspace root or Plans override should hold Daily Plan documents?"
    ],
    "connector_probes": [
      "Check the configured Daily Plan and EOD log directories.",
      "Check agenda renderer path when .docx generation is enabled."
    ],
    "required_artifacts": [
      "Daily Plan output folder.",
      "EOD log folder."
    ],
    "optional_artifacts": [
      "Agenda output folder.",
      "Agenda renderer script."
    ],
    "config_keys": [
      "artifacts.workspace_root",
      "artifacts.path_overrides.plans",
      "artifacts.exports.daily_plan_docx",
      "features.daily_takeaways",
      "features.docx_page_numbers"
    ]
  },
  "enabled_by_default": false,
  "proposal_output_type": "daily_plan_preview"
}
