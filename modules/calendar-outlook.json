{
  "id": "calendar-outlook",
  "display_name": "Outlook Calendar",
  "description": "Read upcoming Outlook calendar meetings through the bundled read-only PowerShell COM script.",
  "required_connectors": [
    "local:outlook-com"
  ],
  "read_sources": [
    {
      "type": "local_script",
      "path": "scripts/Get-OutlookMeetings.ps1",
      "mode": "read-only"
    }
  ],
  "write_targets": [],
  "config_schema": {
    "type": "object",
    "required": [
      "enabled"
    ],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "days_ahead": {
        "type": "integer"
      },
      "target_date": {
        "type": [
          "string",
          "null"
        ]
      }
    }
  },
  "onboarding": {
    "question": "Do you want close-day to read your calendar for tomorrow planning and meeting prep?",
    "default_for_profiles": [
      "solo_operator"
    ],
    "setup_questions": [
      "Which calendar system should close-day read?",
      "If Outlook is selected, is desktop Outlook installed and signed in?"
    ],
    "connector_probes": [
      "Run scripts/Get-OutlookMeetings.ps1 with a dry-run output file."
    ],
    "required_artifacts": [],
    "optional_artifacts": [],
    "config_keys": [
      "modules.calendar-outlook.enabled",
      "modules.calendar-outlook.days_ahead"
    ]
  },
  "enabled_by_default": false,
  "proposal_output_type": "meeting_schedule"
}
