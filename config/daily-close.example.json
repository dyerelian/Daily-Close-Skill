{
  "profile_name": "portable-example",
  "owner": {
    "name": "Example User",
    "primary_email": "user@example.com",
    "timezone": "America/Los_Angeles"
  },
  "write_mode": {
    "enabled": false,
    "require_single_approval": true,
    "external_writes_enabled": false,
    "document_generation_enabled": false,
    "crm_writes_enabled": false
  },
  "enabled_modules": [
    "gmail-sweep",
    "crm-google-sheet"
  ],
  "paths": {
    "python": "python",
    "gtd_workbook": null,
    "daily_plan_dir": null,
    "eod_log_dir": null,
    "agenda_dir": null,
    "add_gtd_items_script": null,
    "agenda_creator_script": null,
    "source_of_truth_skill": null
  },
  "connectors": {
    "gmail": {
      "account": "user@example.com",
      "max_results_per_query": 10,
      "default_window": "newer_than:365d"
    },
    "slack": {
      "workspace": null
    },
    "granola": {},
    "atlassian": {}
  },
  "crm": {
    "workbook_path": "assets/crm/daily-close-crm-template.xlsx",
    "csv_seed_dir": "assets/crm/csv_seed",
    "proposal_output_dir": "outputs/crm-proposals",
    "gmail_seed_queries": [
      {
        "category": "active_customer_program",
        "account_hint": "Example Customer Program",
        "query": "newer_than:365d -in:spam -in:trash (\"Example Customer\" OR \"Example Program\")"
      },
      {
        "category": "active_opportunity_customer_pursuit",
        "account_hint": "Example Opportunity",
        "query": "newer_than:365d -in:spam -in:trash (\"Example Opportunity\" OR pilot)"
      },
      {
        "category": "active_research_customer_collaboration",
        "account_hint": "Example Research Collaboration",
        "query": "newer_than:365d -in:spam -in:trash (\"Example Research\" OR collaboration)"
      },
      {
        "category": "award_program_onboarding",
        "account_hint": "Example Award Program",
        "query": "newer_than:365d -in:spam -in:trash (\"Example Award\" OR onboarding)"
      },
      {
        "category": "partner_ecosystem_relationship",
        "account_hint": "Example Ecosystem Partner",
        "query": "newer_than:365d -in:spam -in:trash (\"Example Partner\" OR ecosystem)"
      },
      {
        "category": "partner_led_pipeline",
        "account_hint": "Example Partner-Led Pipeline",
        "query": "newer_than:365d -in:spam -in:trash (\"Partner Pipeline\" OR conference)"
      }
    ]
  },
  "modules": {
    "gmail-sweep": {
      "enabled": true,
      "account": "user@example.com",
      "default_query": "newer_than:7d -in:spam -in:trash"
    },
    "crm-google-sheet": {
      "enabled": true,
      "workbook_path": "assets/crm/daily-close-crm-template.xlsx",
      "proposal_output_dir": "outputs/crm-proposals",
      "allow_live_sheet_writes": false
    }
  }
}
