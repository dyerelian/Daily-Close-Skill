{
  "schema_version": 2,
  "profile": {
    "id": "portable-example",
    "name": "Portable Example"
  },
  "owner": {
    "name": "Example User",
    "primary_email": "user@example.com",
    "timezone": "UTC"
  },
  "schedule": {
    "workdays": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "close_out_time": "17:00"
  },
  "scopes": [
    {
      "id": "personal",
      "type": "personal",
      "name": "Personal",
      "aliases": ["Personal"],
      "domains": [],
      "include_terms": [],
      "exclude_terms": [],
      "source_bindings": ["personal@example.com"]
    },
    {
      "id": "example-org",
      "type": "organization",
      "name": "Example Organization",
      "aliases": ["Example Org"],
      "domains": ["example.org"],
      "include_terms": ["Example Project"],
      "exclude_terms": [],
      "source_bindings": ["user@example.org"]
    }
  ],
  "routing": {
    "unclassified_policy": "pause_and_ask",
    "global_exclusions": []
  },
  "artifacts": {
    "workspace_root": "~/Documents/close-day",
    "path_overrides": {},
    "canonical": {"markdown": true, "json": true},
    "exports": {
      "docx": false,
      "daily_plan_docx": false,
      "agenda_docx": false,
      "xlsx": false
    }
  },
  "features": {
    "daily_takeaways": {
      "enabled": true,
      "max_items": 3,
      "required_items": 0,
      "incomplete_policy": "allow_partial"
    },
    "recurring_meeting_recap": {"enabled": true},
    "docx_page_numbers": true
  },
  "privacy": {
    "allow_raw_external_content": false,
    "retain_source_snippets": false
  },
  "permissions": {
    "proposal_required": true,
    "external_writes_enabled": false,
    "local_artifact_writes_enabled": false,
    "jira_ticket_approval_required": true,
    "crm_writes_enabled": false,
    "email_delivery_enabled": false
  },
  "enabled_modules": ["mail-sweep", "calendar-sweep", "task-store", "daily-artifacts"],
  "modules": {
    "mail-sweep": {
      "enabled": true,
      "window": "7d",
      "providers": [
        {
          "provider": "gmail",
          "account": "user@example.com",
          "connector": "gmail",
          "configured": false,
          "scope_ids": ["personal", "example-org"]
        }
      ]
    },
    "calendar-sweep": {
      "enabled": true,
      "days_ahead": 1,
      "providers": [
        {
          "provider": "google",
          "account": "user@example.com",
          "connector": "google-calendar",
          "configured": false,
          "scope_ids": ["personal", "example-org"]
        }
      ]
    },
    "task-store": {
      "enabled": true,
      "provider": "portable",
      "existing_path": null,
      "allow_writes": false
    },
    "daily-artifacts": {"enabled": true}
  }
}
