{
  "schema_version": 2,
  "profile": {"id": "my-close", "name": "My Close"},
  "owner": {
    "name": "Example User",
    "primary_email": "user@example.com",
    "timezone": "UTC"
  },
  "schedule": {
    "workdays": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "close_out_time": "17:00"
  },
  "scopes": [
    {
      "id": "personal",
      "type": "personal",
      "name": "Personal",
      "aliases": ["Personal"],
      "domains": [],
      "include_terms": [],
      "exclude_terms": [],
      "source_bindings": ["user@example.com"]
    }
  ],
  "routing": {"global_exclusions": []},
  "artifacts": {
    "workspace_root": "~/Documents/close-day",
    "path_overrides": {},
    "exports": {"docx": false, "xlsx": false}
  },
  "features": {
    "daily_takeaways": {"enabled": true, "max_items": 3},
    "recurring_meeting_recap": {"enabled": true},
    "docx_page_numbers": true
  },
  "privacy": {
    "allow_raw_external_content": false,
    "retain_source_snippets": false
  },
  "permissions": {
    "external_writes_enabled": false,
    "local_artifact_writes_enabled": false,
    "crm_writes_enabled": false
  },
  "systems": {
    "mail": {
      "window": "7d",
      "providers": [
        {
          "provider": "gmail",
          "account": "user@example.com",
          "connector": "gmail",
          "configured": false,
          "scope_ids": ["personal"]
        }
      ]
    },
    "calendar": {
      "days_ahead": 1,
      "providers": [
        {
          "provider": "google",
          "account": "user@example.com",
          "connector": "google-calendar",
          "configured": false,
          "scope_ids": ["personal"]
        }
      ]
    },
    "tasks": {
      "provider": "portable",
      "existing_path": null,
      "allow_writes_after_approval": false
    },
    "optional_modules": {
      "granola-meetings": {"enabled": false, "connector_configured": false},
      "slack-sweep": {"enabled": false, "connector_configured": false, "channels": []},
      "jira-sweep": {"enabled": false, "connector_configured": false, "queries": []},
      "local-files": {
        "enabled": false,
        "roots": [],
        "max_files": 200,
        "max_scanned_files": 5000,
        "max_scanned_directories": 1000,
        "max_scan_seconds": 15
      },
      "teams-local-cache": {"enabled": false},
      "source-of-truth": {"enabled": false, "connector_configured": false},
      "crm-google-sheet": {"enabled": false, "connector_configured": false}
    }
  }
}
